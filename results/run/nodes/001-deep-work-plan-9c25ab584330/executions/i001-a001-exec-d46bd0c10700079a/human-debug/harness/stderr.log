  const result = queryCustomers(customers, new URLSearchParams('q=missing&page=-2&pageSize=no'));
  assert.equal(result.total, 0);
  assert.deepEqual(result.rows, []);
  assert.equal(result.page, 1);
  assert.equal(result.pageSize, 25);
});

