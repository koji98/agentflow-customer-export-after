     1	function positiveInteger(value, fallback, maximum) {
     2	  const parsed = Number(value);
     3	  return Number.isSafeInteger(parsed) && parsed > 0 ? Math.min(parsed, maximum) : fallback;
     4	}
     5	
     6	function queryScope(params) {
     7	  return {
     8	    search: (params.get('q') || '').trim().toLowerCase(),
     9	    status: params.get('status') || 'all',
    10	    segment: params.get('segment') || 'all',
    11	    sort: params.get('sort') || 'id_asc'
    12	  };
    13	}
    14	
    15	function customerMatches(customer, scope) {
    16	  const haystack = [customer.id, customer.name, customer.company, customer.email].join(' ').toLowerCase();
    17	  return (!scope.search || haystack.includes(scope.search))
    18	    && (scope.status === 'all' || customer.status === scope.status)
    19	    && (scope.segment === 'all' || customer.segment === scope.segment);
    20	}
    21	
    22	function compareCustomers(scope) {
    23	  return (a, b) => scope.sort === 'id_desc' ? b.id.localeCompare(a.id) : a.id.localeCompare(b.id);
    24	}
    25	
    26	export function matchingCustomers(customers, params) {
    27	  const scope = queryScope(params);
    28	  return customers.filter(customer => customerMatches(customer, scope)).sort(compareCustomers(scope));
    29	}
    30	
    31	export function queryCustomers(customers, params) {
    32	  const page = positiveInteger(params.get('page'), 1, 100000);
    33	  const pageSize = positiveInteger(params.get('pageSize'), 25, 100);
    34	  const matches = matchingCustomers(customers, params);
    35	  const start = (page - 1) * pageSize;
    36	  return { rows: matches.slice(start, start + pageSize), total: matches.length, page, pageSize };
    37	}

