+  return [columns.join(','), ...rows.map(csvRow)].join('\r\n') + '\r\n';
+}
+
+export function previewExport(customers, params) {
+  const rows = matchingCustomers(customers, params);
+  return { total: rows.length, columns, sample: rows.slice(0, 5) };
 }
