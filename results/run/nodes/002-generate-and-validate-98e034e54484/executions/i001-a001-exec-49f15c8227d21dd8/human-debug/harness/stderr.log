+      <div id="preview-sample-wrap" class="preview-sample-wrap"><h3>First 5 matching customers sample</h3><table><thead><tr><th>ID</th><th>Name</th><th>Company</th><th>Status</th><th>Segment</th></tr></thead><tbody id="preview-sample"></tbody></table></div>
